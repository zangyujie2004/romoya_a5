# Stable Prometheus input path for supported USB foot pedals.
# Legacy PCsensor FootSwitch keyboard interface.
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{idVendor}=="3553", ATTRS{idProduct}=="b001", ENV{ID_INPUT_KEYBOARD}=="1", GROUP="plugdev", MODE="0660", SYMLINK+="input/prometheus-pedal"

# SayoDevice CM6K pedal controller, primary keyboard interface only.
SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_VENDOR_ID}=="8089", ENV{ID_MODEL_ID}=="000c", ENV{ID_SERIAL_SHORT}=="03CDAB68005DBD9269FFFFFFFF0300", ENV{ID_USB_INTERFACE_NUM}=="00", ENV{ID_INPUT_KEYBOARD}=="1", GROUP="plugdev", MODE="0660", SYMLINK+="input/prometheus-pedal"
